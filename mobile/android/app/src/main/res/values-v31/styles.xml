<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 replaces the windowBackground launch screen with its own
     splash screen API, which ignores the layer-list and shows the app icon.
     These attributes brand that screen instead of fighting it. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/omoterra_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon</item>
        <item name="android:windowBackground">@color/omoterra_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/omoterra_background</item>
    </style>
</resources>
