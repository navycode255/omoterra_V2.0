<?xml version="1.0" encoding="utf-8"?>
<!-- The native launch screen is shown until Flutter renders its first frame.
     It carries the logo on the app background so it reads as the start of the
     splash rather than a blank gap before it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/omoterra_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
