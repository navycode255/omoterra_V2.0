# development: local machine. live: a real deployment (e.g. omoterra.jopex.co.tz).
# This does not affect OTP delivery — see OMOTERRA_SMS_PROVIDER below.
OMOTERRA_ENVIRONMENT=development
OMOTERRA_DATABASE_URL=postgresql+psycopg://omoterra:omoterra@localhost:5432/omoterra
OMOTERRA_OPS_TOKEN=replace-with-a-long-random-operator-secret
OMOTERRA_OTP_SECRET=replace-with-a-long-random-secret
# development: no SMS is sent; codes are shown on screen (free, for testing).
# sema: codes are texted through Sema (https://api.sema.co.tz). Members then
# sign in to the website with phone + PIN, so SMS is only spent on registering
# and on a forgotten PIN.
OMOTERRA_SMS_PROVIDER=development
# Required when OMOTERRA_SMS_PROVIDER=sema (from the Sema welcome email /
# customer panel at https://login.sema.co.tz). Never commit real values.
# No OMOTERRA_ prefix: shared with other apps using the same Sema account.
SEMA_API_ID=
SEMA_API_PASSWORD=
# A sender ID approved on your Sema account (see GetSenderIDList).
OMOTERRA_SEMA_SENDER_ID=
# P = promotional, T = transactional, as set up on your Sema account.
OMOTERRA_SEMA_SMS_TYPE=P
OMOTERRA_SEMA_URL=https://api.sema.co.tz/api/SendSMS
# How long a texted code stays valid, and the wait before another can be sent.
OMOTERRA_OTP_TTL_SECONDS=300
OMOTERRA_OTP_RESEND_SECONDS=60
OMOTERRA_FRESHNESS_HOURS=48
OMOTERRA_RESERVATION_MINUTES=15
OMOTERRA_MEDIA_DIRECTORY=./media
# Opens "Admin setup" on the operations sign-in screen (8+ characters).
# Empty turns it off. Once an admin exists, setup also needs their phone code.
OMOTERRA_ADMIN_SETUP_PASSPHRASE=
# Staff sign-in from the mobile app (passphrase, then the operator's phone
# code). 8+ characters; empty keeps it off. Restart the API after changing.
# Keep it different from the admin setup passphrase above.
OMOTERRA_MOBILE_ADMIN_PASSPHRASE=
OMOTERRA_SUPPORT_PHONE=
OMOTERRA_TERMS_TEXT=
OMOTERRA_PRIVACY_TEXT=
