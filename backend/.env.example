# development: local machine. live: a real deployment (e.g. omoterra.jopex.co.tz).
# This does not affect OTP delivery — see OMOTERRA_SMS_PROVIDER below.
OMOTERRA_ENVIRONMENT=development
OMOTERRA_DATABASE_URL=postgresql+psycopg://omoterra:omoterra@localhost:5432/omoterra
OMOTERRA_OPS_TOKEN=replace-with-a-long-random-operator-secret
OMOTERRA_OTP_SECRET=replace-with-a-long-random-secret
# Keep this 'development' even on a live deployment until a real SMS provider
# is integrated — this is what keeps OTP codes free (returned in the API
# response instead of sent by SMS) and is intentionally the only value the
# server currently accepts.
OMOTERRA_SMS_PROVIDER=development
OMOTERRA_FRESHNESS_HOURS=48
OMOTERRA_RESERVATION_MINUTES=15
OMOTERRA_MEDIA_DIRECTORY=./media
OMOTERRA_SUPPORT_PHONE=
OMOTERRA_TERMS_TEXT=
OMOTERRA_PRIVACY_TEXT=
