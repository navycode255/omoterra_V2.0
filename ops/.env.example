# Base URL of the Omoterra FastAPI backend.
OMOTERRA_API_URL=https://omoterra.jopex.co.tz/api/v1
# Canonical public URL for the Omoterra website and operations dashboard.
OMOTERRA_APP_URL=https://omoterra.jopex.co.tz
# The dashboard server's backend credential. Must match OMOTERRA_OPS_TOKEN on
# the backend. Held server-side only and never sent to the browser. Operators
# sign in individually with their phone; see README.
OMOTERRA_OPS_TOKEN=
